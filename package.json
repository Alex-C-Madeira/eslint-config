{
  "name": "@wooden-script/eslint-config",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "author": "Alex Madeira <alex.c.madeira@gmail.com>",
  "description": "Wooden Script ESLint Config simplifies the task of maintaining clean and consistent code in your JavaScript and TypeScript projects. Tailored by Alex Madeira, it offers straightforward configurations for React and Node.js applications. Integrated with Prettier, this ESLint setup ensures code adheres to standards while maintaining a neatly formatted codebase.",
  "repository": "Alex-C-Madeira/eslint-config",
  "homepage": "https://github.com/Alex-C-Madeira/eslint-config",
  "keywords": [
    "eslint",
    "config",
    "typescript",
    "react",
    "prettier",
    "linting",
    "code style",
    "javascript",
    "nodejs",
    "configuration"
  ],
  "main": "./index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    },
    "./base": {
      "types": "./types/base.d.ts",
      "import": "./base.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "import": "./node.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./react.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "import": "./config.js"
    },
    "./config/import-sort": {
      "types": "./types/config/import-sort.d.ts",
      "import": "./config/import-sort.js"
    },
    "./config/prettier": {
      "types": "./types/config/prettier.d.ts",
      "import": "./config/prettier.js"
    },
    "./config/react": {
      "types": "./types/config/react.d.ts",
      "import": "./config/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "base.js",
    "node.js",
    "react.js",
    "index.js",
    "config.js",
    "config",
    "types",
    "README.md",
    "CHANGELOG.md",
    "assets"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "pack:check": "HUSKY=0 npm_config_cache=/tmp/wooden-script-eslint-config-npm-cache npm pack --dry-run"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "@eslint-react/eslint-plugin": "5.8.16",
    "eslint-plugin-n": "18.1.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "25.9.2",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "semantic-release": "25.0.3",
    "typescript": "6.0.3"
  }
}
